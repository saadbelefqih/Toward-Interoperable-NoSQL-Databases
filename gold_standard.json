        {"field": "subscription_tier",          "expected_uri": null, "expected_type": null, "category": "negative",  "note": "Internal pricing tier; no ontology equivalent"},
        {"field": "last_login",                 "expected_uri": null, "expected_type": null, "category": "evolution", "note": "Session timestamp; no ontology equivalent"}
