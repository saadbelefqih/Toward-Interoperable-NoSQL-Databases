        {"field": "first_name",        "expected_uri": "http://xmlns.com/foaf/0.1/firstName", "expected_type": "xsd:string", "category": "positive", "note": "FOAF firstName — confirmed in schema_org_mappings"},
        {"field": "last_name",         "expected_uri": "http://xmlns.com/foaf/0.1/lastName",  "expected_type": "xsd:string", "category": "positive", "note": "FOAF lastName — confirmed in schema_org_mappings"},
