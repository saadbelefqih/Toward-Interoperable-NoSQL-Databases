{
  "_metadata": {
    "title": "Gold Standard Vocabulary Annotation File",
    "description": "Manually curated reference mappings for semantic vocabulary alignment evaluation. Each entry maps a document attribute field — exactly as it appears in the FakeDataGenerator output — to its expected ontology URI and XSD datatype, or marks it as unmappable (null). Used by SchemaExtractionEvaluator and OntologyLinkingEvaluator to compute Precision, Recall, F1-score and Accuracy.",
    "source_file": "JSONLD.ipynb",
    "source_classes": [
      "GroundTruthGenerator.schema_org_mappings",
      "GROUND_TRUTH",
      "GROUND_TRUTH_EVOLUTION"
    ],
    "ontologies_referenced": [
      "http://schema.org/",
      "http://xmlns.com/foaf/0.1/"
    ],
    "evaluation_protocol": "Field-level URI comparison: predicted_uri == expected_uri → TP; predicted_uri != expected_uri and predicted_uri is not null → FP; predicted_uri is null and expected_uri is not null → FN; both null → TN. Metrics: Precision, Recall, F1-score, Accuracy.",
    "categories": {
      "positive":  "Field with a confirmed ontology mapping — SBERT reliably maps it above the 0.75 similarity threshold",
      "medium":    "Field with an ambiguous or abbreviated label — SBERT may occasionally miss it",
      "negative":  "Opaque internal token with no ontology equivalent — correctly left unmapped",
      "evolution": "Field introduced by schema evolution (generate_schema_evolution_data); same mapping rules apply"
    },
    "xsd_prefix": "http://www.w3.org/2001/XMLSchema#",
    "version": "1.0",
    "last_updated": "2024-09-01"
  },

  "collections": {

    "users": {
