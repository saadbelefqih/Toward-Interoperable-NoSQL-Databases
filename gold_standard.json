        {"field": "address.state",     "expected_uri": "http://schema.org/addressRegion",     "expected_type": "xsd:string", "category": "positive", "note": "Confirmed in schema_org_mappings"},
        {"field": "address.zip",       "expected_uri": "http://schema.org/postalCode",        "expected_type": "xsd:string", "category": "positive", "note": "Confirmed in schema_org_mappings"},
        {"field": "address.country",   "expected_uri": "http://schema.org/addressCountry",    "expected_type": "xsd:string", "category": "positive", "note": "Confirmed in schema_org_mappings"},
        {"field": "created_at",        "expected_uri": null,                                  "expected_type": null,         "category": "medium",   "note": "Timestamp field; no direct match in ontology index — falls to local namespace"}
