        {'term': 'telephone',      'uri': 'http://schema.org/telephone',       'domain': 'schema.org'},
        {'term': 'birthDate',      'uri': 'http://schema.org/birthDate',       'domain': 'schema.org'},
        {'term': 'address',        'uri': 'http://schema.org/address',         'domain': 'schema.org'},
        {'term': 'gender',         'uri': 'http://schema.org/gender',          'domain': 'schema.org'},
