        {'term': 'totalPrice',     'uri': 'http://schema.org/totalPrice',      'domain': 'schema.org'},
        {'term': 'total',          'uri': 'http://schema.org/totalPrice',      'domain': 'schema.org'},
        {'term': 'status',         'uri': 'http://schema.org/orderStatus',     'domain': 'schema.org'},
        # ── FOAF ───────────────────────────────────────────────────────────────
        {'term': 'person',         'uri': 'http://xmlns.com/foaf/0.1/Person',  'domain': 'foaf'},
        {'term': 'firstName',      'uri': 'http://xmlns.com/foaf/0.1/firstName','domain': 'foaf'},
        {'term': 'lastName',       'uri': 'http://xmlns.com/foaf/0.1/lastName','domain': 'foaf'},
        {'term': 'mbox',           'uri': 'http://xmlns.com/foaf/0.1/mbox',    'domain': 'foaf'},
        {'term': 'phone',          'uri': 'http://xmlns.com/foaf/0.1/phone',   'domain': 'foaf'},
    ]

    def __init__(self, db: InMemoryDatabase):
        self.db = db
        self.contexts_collection       = '@contexts'
        self.ontology_index_collection = '@ontologyIndex'

        # Lazy import so the file can be imported without sentence_transformers
        # (unit tests, linting) – the actual encode calls will fail gracefully.
        try:
            from sentence_transformers import SentenceTransformer
            import faiss as _faiss
            self.model = SentenceTransformer('all-MiniLM-L6-v2')
            self.embedding_dim = self.model.get_sentence_embedding_dimension()
            self.index = _faiss.IndexFlatIP(self.embedding_dim)
            self._faiss = _faiss
        except ImportError as e:
            raise ImportError(
                "sentence-transformers and faiss-cpu are required. "
                "Run: pip install sentence-transformers faiss-cpu"
            ) from e

        self._init_ontology_index()

    def _init_ontology_index(self):
        if self.db.count_documents(self.ontology_index_collection, {}) > 0:
            self._reload_index()
            return

        print('  Initialising ontology index …')
        terms_text = [t['term'] for t in self.STANDARD_TERMS]
        embeddings = self.model.encode(terms_text, convert_to_numpy=True)

        # ── FIX 4: L2-normalise row-by-row so IndexFlatIP ≡ cosine similarity ─
        norms = np.linalg.norm(embeddings, axis=1, keepdims=True)
        embeddings = embeddings / np.maximum(norms, 1e-10)
        self.index.add(embeddings)

        for i, term in enumerate(self.STANDARD_TERMS):
            entry = term.copy()
            entry['embedding_id'] = i
            self.db.insert_one(self.ontology_index_collection, entry)

        print(f'  Ontology index ready ({len(self.STANDARD_TERMS)} terms).')

    def _reload_index(self):
        self.index = self._faiss.IndexFlatIP(self.embedding_dim)
        stored = self.db.find(self.ontology_index_collection, {})
        if not stored:
            return

        # ── FIX 4: stack into 2-D array FIRST, then normalise row-by-row ──────
        embs = np.vstack([
            self.model.encode(t['term'], convert_to_numpy=True) for t in stored
        ])
        norms = np.linalg.norm(embs, axis=1, keepdims=True)
        embs  = embs / np.maximum(norms, 1e-10)
        self.index.add(embs)
        print(f'  Reloaded {len(stored)} terms into ontology index.')

    def preprocess_attribute(self, attribute: str) -> str:
        s = re.sub('(.)([A-Z][a-z]+)', r'\1 \2', attribute)
        s = re.sub('([a-z0-9])([A-Z])', r'\1 \2', s)
        s = re.sub(r'[^a-zA-Z0-9\s]', ' ', s).lower()
        return re.sub(r'\s+', ' ', s).strip()

    def map_attribute_to_vocabulary(self, attribute: str) -> Dict:
        norm = self.preprocess_attribute(attribute)
        emb  = self.model.encode(norm, convert_to_numpy=True).reshape(1, -1)
        # ── FIX 4: normalise query vector before inner-product search ──────────
        emb  = emb / np.maximum(np.linalg.norm(emb), 1e-10)
        scores, indices = self.index.search(emb, 5)

        for score, idx in zip(scores[0], indices[0]):
            if idx >= 0:
                t = self.db.find_one(self.ontology_index_collection,
                                     {'embedding_id': int(idx)})
                if t and float(score) >= self.SIMILARITY_THRESHOLD:
                    return {
                        'term':                 t['term'],
                        'uri':                  t['uri'],
                        'domain':               t['domain'],
                        'similarity':           float(score),
                        'original_attribute':   attribute,
                        'normalized_attribute': norm
                    }

        return {
            'original_attribute':   attribute,
            'normalized_attribute': norm,
            'term':                 attribute,
            'uri':                  f'https://example.org/vocab#{attribute}',
            'domain':               'default',
            'similarity':           0.0
        }

    def infer_datatype(self, value: Any) -> str:
        if value is None:           return 'http://www.w3.org/2001/XMLSchema#nil'
        if isinstance(value, bool): return 'http://www.w3.org/2001/XMLSchema#boolean'
        if isinstance(value, int):  return 'http://www.w3.org/2001/XMLSchema#integer'
        if isinstance(value, float):return 'http://www.w3.org/2001/XMLSchema#decimal'
        if isinstance(value, list): return 'http://www.w3.org/2001/XMLSchema#array'
        if isinstance(value, dict): return 'http://www.w3.org/2001/XMLSchema#object'
        if isinstance(value, str):
            if re.match(r'^\d{4}-\d{2}-\d{2}T', value):
                return 'http://www.w3.org/2001/XMLSchema#dateTime'
            if re.match(r'^\d{4}-\d{2}-\d{2}$', value):
                return 'http://www.w3.org/2001/XMLSchema#date'
        return 'http://www.w3.org/2001/XMLSchema#string'

    def generate_context_for_schema(self, schema_profile: Dict) -> Dict:
        ctx: Dict = {'@context': {
            'xsd':    'http://www.w3.org/2001/XMLSchema#',
            'schema': 'http://schema.org/',
            'foaf':   'http://xmlns.com/foaf/0.1/',
            'ex':     'https://example.org/vocab#'
        }}
        mappings: Dict = {}

        for field, info in schema_profile['fields'].items():
            if field.startswith('_'):
                continue
            m  = self.map_attribute_to_vocabulary(field)
            sv = self._get_sample_value(schema_profile['collection'], field)
            dt = self.infer_datatype(sv) if sv is not None else None

            if m['similarity'] >= self.SIMILARITY_THRESHOLD:
                mappings[field] = ({'@id': m['uri'], '@type': dt} if dt else m['uri'])
            else:
                mappings[field] = {'@id': f"ex:{field}", '@type': dt or 'xsd:string'}

        ctx['@context'].update(mappings)
        ctx['@metadata'] = {
            'collection': schema_profile['collection'],
            'version':    schema_profile['version'],
            'generated':  datetime.now().isoformat()
        }
        if 'previous_version' in schema_profile:
            ctx['@metadata']['previous_version'] = schema_profile['previous_version']
        if 'changes' in schema_profile:
            ctx['@metadata']['changes'] = schema_profile['changes']
        return ctx

    def _get_sample_value(self, collection: str, field: str) -> Any:
        if '.' not in field:
            doc = self.db.find_one(collection, {field: {'$exists': True}})
            return doc.get(field) if doc else None

        parts = field.split('.')
        doc   = self.db.find_one(collection, {parts[0]: {'$exists': True}})
        if not doc:
            return None
        val = doc
        for p in parts:
            if p == '[]' and isinstance(val, list) and val:
                val = val[0]
            elif isinstance(val, dict) and p in val:
                val = val[p]
            else:
                return None
        return val

    def store_context(self, context: Dict) -> str:
        result = self.db.insert_one(self.contexts_collection, context)
        return str(result['inserted_id'])

    def get_latest_context_for_collection(self, collection: str) -> Optional[Dict]:
        return self.db.find_one(
            self.contexts_collection,
            {'@metadata.collection': collection},
            sort=[('_id', -1)]
        )


