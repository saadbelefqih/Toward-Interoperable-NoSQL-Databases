# ── FIX 2: InMemoryDatabase must be defined BEFORE any code that uses it ──────
class InMemoryDatabase:
    """
    Lightweight in-memory store that mirrors the MongoDB Collection API used
    by the framework.  No external database is required to run the experiments.
    """

    def __init__(self):
        self.collections: Dict[str, List[Dict]] = defaultdict(list)
        self._id_counters: Dict[str, int] = defaultdict(int)

    # ── CRUD ───────────────────────────────────────────────────────────────────
    def insert_one(self, collection: str, document: Dict) -> Dict:
        doc = document.copy()
        if '_id' not in doc:
            self._id_counters[collection] += 1
            doc['_id'] = str(self._id_counters[collection])
        self.collections[collection].append(doc)
        return {'inserted_id': doc['_id']}

    def insert_many(self, collection: str, documents: List[Dict]) -> Dict:
        ids = [self.insert_one(collection, d)['inserted_id'] for d in documents]
        return {'inserted_ids': ids}

    def find_one(self, collection: str, query: Dict = None,
                 sort: List = None) -> Optional[Dict]:
        results = self.find(collection, query, sort, limit=1)
        return results[0] if results else None

    def find(self, collection: str, query: Dict = None,
             sort: List = None, limit: int = None) -> List[Dict]:
        docs = list(self.collections[collection])

        if query:
            filtered = []
            for doc in docs:
                match = True
                for key, val in query.items():
                    if isinstance(val, dict):
                        for op, ov in val.items():
                            if op == '$exists':
                                present = key in doc
                                if ov and not present:
                                    match = False
                                elif not ov and present:
                                    match = False
                    elif doc.get(key) != val:
                        match = False
                if match:
                    filtered.append(doc)
            docs = filtered

        if sort:
            for field, direction in reversed(sort):
                docs = sorted(docs, key=lambda d: d.get(field, ''),
                              reverse=(direction < 0))

        if limit and limit > 0:
            docs = docs[:limit]
        return docs

    def update_one(self, collection: str, query: Dict,
                   update: Dict, upsert: bool = False) -> Dict:
        docs = self.find(collection, query)
        if docs:
            if '$set' in update:
                for k, v in update['$set'].items():
                    docs[0][k] = v
            return {'modified_count': 1}
        if upsert:
            new_doc = {}
            if '$set' in update:
                new_doc.update(update['$set'])
            self.insert_one(collection, new_doc)
            return {'modified_count': 0, 'upserted': True}
        return {'modified_count': 0}

    # ── FIX 3: update_many and delete_one were missing from InMemoryDatabase ──
    def update_many(self, collection: str, query: Dict, update: Dict) -> Dict:
        docs = self.find(collection, query)
        count = 0
        for doc in docs:
            if '$set' in update:
                for k, v in update['$set'].items():
                    doc[k] = v
            count += 1
        return {'modified_count': count}

    def delete_one(self, collection: str, query: Dict) -> Dict:
        docs = self.collections[collection]
        for i, doc in enumerate(docs):
            match = all(doc.get(k) == v for k, v in query.items()
                        if not isinstance(v, dict))
            if match:
                docs.pop(i)
                return {'deleted_count': 1}
        return {'deleted_count': 0}

    def count_documents(self, collection: str, query: Dict = None) -> int:
        return len(self.find(collection, query or {}))

    def list_collection_names(self) -> List[str]:
        return list(self.collections.keys())

    def create_index(self, *args, **kwargs):
        pass   # no-op for in-memory store


