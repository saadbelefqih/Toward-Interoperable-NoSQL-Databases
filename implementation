        {'term': 'addressLocality','uri': 'http://schema.org/addressLocality', 'domain': 'schema.org'},
        {'term': 'addressRegion',  'uri': 'http://schema.org/addressRegion',   'domain': 'schema.org'},
        {'term': 'postalCode',     'uri': 'http://schema.org/postalCode',      'domain': 'schema.org'},
        {'term': 'addressCountry', 'uri': 'http://schema.org/addressCountry',  'domain': 'schema.org'},
        {'term': 'addressCity',    'uri': 'http://schema.org/addressLocality', 'domain': 'schema.org'},
        {'term': 'addressState',   'uri': 'http://schema.org/addressRegion',   'domain': 'schema.org'},
