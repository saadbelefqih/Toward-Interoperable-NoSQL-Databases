# 4. Context Registry and Versioning
# ══════════════════════════════════════════════════════════════════════════════
class ContextRegistry:
    """Manages versioned semantic contexts and their relationships."""

    def __init__(self, db: InMemoryDatabase):
        self.db = db
        self.contexts_collection    = '@contexts'
        self.doc_contexts_collection = '@docContexts'

    def register_context(self, context: Dict) -> str:
        if '@metadata' not in context:
            context['@metadata'] = {}
        context['@metadata']['created'] = datetime.now().isoformat()
        result = self.db.insert_one(self.contexts_collection, context)
        return str(result['inserted_id'])

    def get_context(self, context_id: str) -> Optional[Dict]:
        return self.db.find_one(self.contexts_collection, {'_id': context_id})

    def list_contexts(self, collection: str = None) -> List[Dict]:
        query = {'@metadata.collection': collection} if collection else {}
        return self.db.find(self.contexts_collection, query)

    def get_context_history(self, collection: str) -> List[Dict]:
        contexts = self.db.find(
            self.contexts_collection,
            {'@metadata.collection': collection},
            sort=[('@metadata.created', 1)]
        )
        return [
            {
                'id':               ctx['_id'],
                'version':          ctx['@metadata'].get('version', 'unknown'),
                'created':          ctx['@metadata'].get('created', 'unknown'),
                'previous_version': ctx['@metadata'].get('previous_version'),
                'changes':          ctx['@metadata'].get('changes', {})
            }
            for ctx in contexts
        ]

    def get_latest_context_for_collection(self, collection: str) -> Optional[Dict]:
        return self.db.find_one(
            self.contexts_collection,
            {'@metadata.collection': collection},
            sort=[('_id', -1)]
        )

    def associate_document_with_context(self, doc_id: str, collection: str,
                                         context_id: str) -> bool:
        existing = self.db.find_one(
            self.doc_contexts_collection,
            {'doc_id': doc_id, 'collection': collection}
        )
        mapping = {
            'doc_id':     doc_id,
            'collection': collection,
            'context_id': context_id,
            'mapped_at':  datetime.now().isoformat()
        }
        if existing:
            result = self.db.update_one(
                self.doc_contexts_collection,
                {'_id': existing['_id']},
                {'$set': {'context_id': context_id, 'mapped_at': mapping['mapped_at']}}
            )
            return result['modified_count'] > 0
        result = self.db.insert_one(self.doc_contexts_collection, mapping)
        return result['inserted_id'] is not None

    def get_document_context(self, doc_id: str, collection: str) -> Optional[str]:
        mapping = self.db.find_one(
            self.doc_contexts_collection,
            {'doc_id': doc_id, 'collection': collection}
        )
        return mapping['context_id'] if mapping else None

    def update_documents_to_latest_context(self, collection: str,
                                            context_id: str) -> int:
        result = self.db.update_many(
            self.doc_contexts_collection,
            {'collection': collection},
            {'$set': {'context_id': context_id, 'mapped_at': datetime.now().isoformat()}}
        )
        return result['modified_count']


# ══════════════════════════════════════════════════════════════════════════════
# 5. Mapping Management
# ══════════════════════════════════════════════════════════════════════════════
class MappingManager:
    """Manages associations between documents and their semantic contexts."""

    def __init__(self, db: InMemoryDatabase, context_registry: ContextRegistry):
        self.db               = db
        self.context_registry = context_registry
        self.doc_contexts_collection = '@docContexts'

    def register_document_mapping(self, doc_id: str, collection: str) -> bool:
        latest = self.context_registry.get_latest_context_for_collection(collection)
        if not latest:
            return False
        return self.context_registry.associate_document_with_context(
            doc_id, collection, latest['_id']
        )

    def update_document_mapping(self, doc_id: str, collection: str,
                                 context_id: str = None) -> bool:
        if not context_id:
            latest = self.context_registry.get_latest_context_for_collection(collection)
            if not latest:
                return False
            context_id = latest['_id']
        return self.context_registry.associate_document_with_context(
            doc_id, collection, context_id
        )

    def batch_update_mappings(self, collection: str, context_id: str = None) -> int:
        if not context_id:
            latest = self.context_registry.get_latest_context_for_collection(collection)
            if not latest:
                return 0
            context_id = latest['_id']
        return self.context_registry.update_documents_to_latest_context(
            collection, context_id
        )

    def get_document_context_id(self, doc_id: str, collection: str) -> Optional[str]:
        return self.context_registry.get_document_context(doc_id, collection)

    def get_unmapped_documents(self, collection: str) -> List[str]:
        all_ids    = {d['_id'] for d in self.db.find(collection, {})}
        mapped_ids = {d['doc_id'] for d in
                      self.db.find(self.doc_contexts_collection,
                                   {'collection': collection})}
        return list(all_ids - mapped_ids)


# ══════════════════════════════════════════════════════════════════════════════
# 6. JSON-LD Reconstruction Service
# ══════════════════════════════════════════════════════════════════════════════
class JsonLdService:
    """Reconstructs JSON-LD documents by merging raw data with context."""

    def __init__(self, db: InMemoryDatabase, mapping_manager: MappingManager):
        self.db              = db
        self.mapping_manager = mapping_manager

    def enrich_document(self, doc_id: str, collection: str) -> Optional[Dict]:
        raw = self.db.find_one(collection, {'_id': doc_id})
        if not raw:
            return None

        context_id = self.mapping_manager.get_document_context_id(doc_id, collection)

        if context_id:
            ctx_doc = self.db.find_one('@contexts', {'_id': context_id})
            context = ctx_doc['@context'] if ctx_doc else {}
        else:
            latest = self.db.find_one('@contexts',
                                      {'@metadata.collection': collection},
                                      sort=[('_id', -1)])
            context = latest['@context'] if latest else {}

        enriched = raw.copy()
        enriched['@context'] = context
        return enriched

    def enrich_collection(self, collection: str,
                           limit: int = None) -> List[Dict]:
        docs     = self.db.find(collection, {}, limit=limit)
        enriched = []
        for doc in docs:
            result = self.enrich_document(doc['_id'], collection)
            if result:
                enriched.append(result)
        return enriched

    def export_as_jsonld(self, doc_id: str, collection: str,
                          output_file: str = None) -> Optional[Dict]:
        doc = self.enrich_document(doc_id, collection)
        if doc and output_file:
            with open(output_file, 'w') as f:
                json.dump(doc, f, indent=2)
        return doc


# ══════════════════════════════════════════════════════════════════════════════
# Main Framework Class
# ══════════════════════════════════════════════════════════════════════════════
class SemanticEnrichmentFramework:
    """Integrates all framework components into a single entry point."""

    def __init__(self, db_client: InMemoryDatabase = None):
        self.db                = db_client or InMemoryDatabase()
        self.vocabulary_mapper = VocabularyMapper(self.db)
        self.context_registry  = ContextRegistry(self.db)
        self.mapping_manager   = MappingManager(self.db, self.context_registry)
        self.jsonld_service    = JsonLdService(self.db, self.mapping_manager)
        self._storage:  Dict[str, DataStorage]   = {}
        self._profilers:Dict[str, SchemaProfiler] = {}

    def get_data_storage(self, collection: str) -> DataStorage:
        if collection not in self._storage:
            self._storage[collection] = DataStorage(self.db, collection)
        return self._storage[collection]

    def get_schema_profiler(self, collection: str) -> SchemaProfiler:
        if collection not in self._profilers:
            self._profilers[collection] = SchemaProfiler(self.db, collection)
        return self._profilers[collection]

    def process_document(self, document: Dict, collection: str) -> str:
        doc_id = self.get_data_storage(collection).insert_document(document)
        self.mapping_manager.register_document_mapping(doc_id, collection)
        return doc_id

    def process_collection(self, collection: str) -> Dict:
        profiler = self.get_schema_profiler(collection)
        has_changes, schema_profile = profiler.detect_schema_changes()

        if has_changes:
            context    = self.vocabulary_mapper.generate_context_for_schema(schema_profile)
            context_id = self.context_registry.register_context(context)
            updated    = self.mapping_manager.batch_update_mappings(collection, context_id)
            return {'collection': collection, 'changes_detected': True,
                    'context_id': context_id, 'updated_documents': updated}

        return {'collection': collection, 'changes_detected': False}

    def get_document_as_jsonld(self, doc_id: str, collection: str) -> Optional[Dict]:
        return self.jsonld_service.enrich_document(doc_id, collection)


