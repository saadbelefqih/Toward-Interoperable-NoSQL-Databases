        # ── Schema.org Organization ────────────────────────────────────────────
        {'term': 'organization',   'uri': 'http://schema.org/Organization',    'domain': 'schema.org'},
        {'term': 'legalName',      'uri': 'http://schema.org/legalName',       'domain': 'schema.org'},
        {'term': 'founder',        'uri': 'http://schema.org/founder',         'domain': 'schema.org'},
        {'term': 'foundingDate',   'uri': 'http://schema.org/foundingDate',    'domain': 'schema.org'},
        # ── Schema.org Product ─────────────────────────────────────────────────
        {'term': 'product',        'uri': 'http://schema.org/Product',         'domain': 'schema.org'},
        {'term': 'productID',      'uri': 'http://schema.org/productID',       'domain': 'schema.org'},
        {'term': 'price',          'uri': 'http://schema.org/price',           'domain': 'schema.org'},
        {'term': 'description',    'uri': 'http://schema.org/description',     'domain': 'schema.org'},
        {'term': 'brand',          'uri': 'http://schema.org/brand',           'domain': 'schema.org'},
        {'term': 'manufacturer',   'uri': 'http://schema.org/manufacturer',    'domain': 'schema.org'},
